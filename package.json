{
  "name": "deep-toolbox",
  "version": "0.1.0",
  "description": "See which tools your DeepSeek Harness agents actually use, how often each one fails, and what its definition costs in every request — so you know which tools and MCP servers to keep or drop.",
  "icon": "./icon.svg",
  "author": "Johannes Tebbert <info@joblessjoe.com> (https://joblessjoe.com)",
  "type": "module",
  "main": "lib/index.js",
  "bin": { "deep-toolbox": "lib/cli.js" },
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" },
    "compatibility": { "dsh": ">=0.2.2-rc.1 <0.4.0-0" }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Tool usage & startup cost",
    "summary": "Tool usage, error rates and per-request token cost of every built-in and MCP tool, across all sessions.",
    "categories": ["Observability", "Web UI", "Tools"],
    "surfaces": ["host", "web"],
    "compatibility": { "dsh": ">=0.2.2-rc.1 <0.4.0-0", "node": ">=22.15" },
    "permissions": {}
  },
  "files": ["lib", "cordis.patch.yml", "icon.svg"],
  "peerDependencies": { "react": "^18.0.0 || ^19.0.0" },
  "repository": { "type": "git", "url": "git+https://github.com/JoblessJoe/deep-toolbox.git" },
  "keywords": ["deepseek", "deepseek-harness", "dsh", "dsh-plugin", "client-plugin", "mcp", "tools", "token", "cost", "usage", "observability", "工具统计", "dsh插件"],
  "license": "MIT",
  "engines": { "node": ">=22.15" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/stats.test.ts"
  },
  "devDependencies": { "esbuild": "^0.28.2" }
}
